enum LeaderboardEventType {
  PR_MERGED
  ISSUE_COMPLETED
  BONUS
  PENALTY
  MANUAL_ADJUSTMENT
}

enum IssueStatus {
  OPEN
  CLOSED
  ASSIGNED
}

enum PRStatus {
  MERGED
  OPENED
  REJECTED
}
