generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model admin {
  id     String @id
  userId String @unique(map: "Admin_userId_key")
}

model coverimageurl {
  id        Int    @id @default(autoincrement())
  url       String @unique(map: "coverImageURL_url_key")
  eventName String

  @@index([eventName], map: "coverImageURL_eventName_idx")
}

model event {
  id           String    @id
  creatorId    String
  name         String    @unique(map: "Event_name_key")
  description  String?
  startDate    DateTime  @default(now())
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  deletedAt    DateTime?
  logoImageURL String?

  @@index([creatorId], map: "Event_creatorId_idx")
}

model issue {
  id            String       @id
  repoName      String
  assigneeId    String?
  issueNumber   Int
  title         String
  status        issue_status @default(OPEN)
  openForAll    Boolean      @default(false)
  currentPoints Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  deletedAt     DateTime?

  @@unique([repoName, issueNumber], map: "Issue_repoName_issueNumber_key")
  @@index([assigneeId], map: "Issue_assigneeId_idx")
}

model leaderboardentry {
  id            String @id
  participantId String
  eventName     String
  points        Int    @default(0)
  PRmerged      Int    @default(0)

  @@unique([participantId, eventName], map: "LeaderboardEntry_participantId_eventName_key")
  @@index([eventName], map: "LeaderboardEntry_eventName_idx")
}

model leaderboardsnapshot {
  id            String   @id
  participantId String
  eventName     String
  date          DateTime
  totalPoints   Int      @default(0)
  PRmerged      Int      @default(0)

  @@unique([participantId, eventName, date], map: "LeaderboardSnapshot_participantId_eventName_date_key")
  @@index([eventName, date], map: "LeaderboardSnapshot_eventName_date_idx")
  @@index([participantId, date], map: "LeaderboardSnapshot_participantId_date_idx")
}

model participant {
  id            String @id
  participantId String @unique(map: "Participant_participantId_key")
}

model pr {
  id          BigInt    @id
  title       String
  submitterId String
  issueId     String
  prNumber    Int
  points      Int
  status      pr_status @default(OPENED)

  @@index([issueId], map: "PR_issueId_idx")
  @@index([submitterId], map: "PR_submitterId_idx")
}

model repo {
  id            String    @id
  creatorId     String
  eventName     String
  name          String    @unique(map: "Repo_name_key")
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  deletedAt     DateTime?
  isFirstYrOnly Boolean   @default(false)
  isGirlsOnly   Boolean   @default(false)

  @@index([creatorId], map: "Repo_creatorId_idx")
  @@index([eventName], map: "Repo_eventName_idx")
}

model user {
  id             String    @id
  isAdmin        Boolean   @default(false)
  name           String    @db.VarChar(255)
  email          String    @unique(map: "User_email_key")
  avatarUrl      String
  college        String
  graduationYear Int
  branch         String
  degree         String
  discordId      String?   @unique(map: "User_discordId_key")
  githubId       String    @unique(map: "User_githubId_key")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  deletedAt      DateTime?
  year           String    @db.VarChar(20)
  gender         String    @default("male") @db.VarChar(20)

  @@index([githubId], map: "User_githubId_idx")
}

enum issue_status {
  OPEN
  CLOSED
  ASSIGNED
}

enum pr_status {
  MERGED
  OPENED
  REJECTED
}
