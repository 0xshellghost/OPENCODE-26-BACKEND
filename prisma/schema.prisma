generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  relationMode      = "prisma"
}

model User {
  id             String       @id @default(uuid())
  isAdmin        Boolean      @default(false)
  isMentor       Boolean      @default(false)
  name           String       @db.VarChar(255)
  email          String       @unique
  avatarUrl      String
  college        String
  graduationYear Int
  branch         String
  degree         String
  discordId      String?      @unique
  githubId       String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  gender         String       @default("male") @db.VarChar(20)
  year           String       @db.VarChar(20)
  Admin          Admin?
  Participant    Participant?
  GCOrders       GCOrder[]
  GCCart         GCCart?

  @@index([githubId])
}

model Admin {
  id     String  @id @default(uuid())
  userId String  @unique
  user   User    @relation(fields: [userId], references: [githubId])
  Event  Event[]
  Repo   Repo[]
}

model Participant {
  id                 String             @id @default(uuid())
  participantId      String             @unique
  User               User               @relation(fields: [participantId], references: [githubId])
  PR                 PR[]
  Issue              Issue[]
  LeaderboardEntries LeaderboardEntry[]
  LeaderboardEvents  LeaderboardEvent[]
}

model Event {
  id                 String             @id @default(cuid())
  creatorId          String
  name               String             @unique
  description        String?
  startDate          DateTime           @default(now())
  endDate            DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  logoImageURL       String?
  isFlagship         Boolean            @default(false)
  creator            Admin              @relation(fields: [creatorId], references: [userId])
  Repo               Repo[]
  LeaderBoardEntries LeaderboardEntry[]
  LeaderboardEvents  LeaderboardEvent[]
  coverImagesURL     coverImageURL[]

  @@index([creatorId])
}

model coverImageURL {
  id        Int    @id @default(autoincrement())
  url       String @unique
  eventName String
  event     Event  @relation(fields: [eventName], references: [name])

  @@index([eventName])
}

model LeaderboardEntry {
  id            String      @id @default(uuid())
  participantId String
  eventName     String
  points        Int         @default(0)
  PRmerged      Int         @default(0)
  Participant   Participant @relation(fields: [participantId], references: [participantId])
  event         Event       @relation(fields: [eventName], references: [name])

  @@unique([participantId, eventName])
  @@index([eventName])
}

model LeaderboardEvent {
  id            String               @id @default(uuid())
  participantId String
  eventName     String
  type          LeaderboardEventType
  pointsDelta   Int
  prId          BigInt?
  issueId       String?
  createdAt     DateTime             @default(now())
  participant   Participant          @relation(fields: [participantId], references: [participantId])
  event         Event                @relation(fields: [eventName], references: [name])

  @@index([participantId, createdAt])
  @@index([eventName, createdAt])
  @@index([participantId, eventName])
}

model Repo {
  id            String    @id @default(uuid())
  creatorId     String
  eventName     String
  name          String    @unique
  description   String?
  tags          String?   @db.Text
  language      String?   @db.VarChar(100)
  mentors       String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  isFirstYrOnly Boolean   @default(false)
  isGirlsOnly   Boolean   @default(false)
  creator       Admin     @relation(fields: [creatorId], references: [userId])
  event         Event     @relation(fields: [eventName], references: [name])
  issues        Issue[]

  @@index([creatorId])
  @@index([eventName])
}

model Issue {
  id            String       @id @default(uuid())
  repoName      String
  assigneeId    String?
  issueNumber   Int
  title         String
  status        IssueStatus  @default(OPEN)
  openForAll    Boolean      @default(false)
  currentPoints Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  repo          Repo         @relation(fields: [repoName], references: [name])
  PR            PR[]
  assignee      Participant? @relation(fields: [assigneeId], references: [participantId])

  @@unique([repoName, issueNumber])
  @@index([assigneeId])
}

model PR {
  id          BigInt      @id
  title       String
  submitterId String
  issueId     String
  prNumber    Int
  points      Int
  status      PRStatus    @default(OPENED)
  submitter   Participant @relation(fields: [submitterId], references: [participantId])
  issue       Issue       @relation(fields: [issueId], references: [id])

  @@index([submitterId])
  @@index([issueId])
}

model GC_Wallet {
  id           String           @id @default(uuid())
  githubId     String           @unique
  balance      Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  transactions GC_Transaction[]

  @@index([githubId])
  @@map("gc_wallet")
}

model GC_Transaction {
  id             String    @id @default(uuid())
  walletId       String    @map("wallet_id")
  githubId       String    @map("github_id")
  amount         Int
  reason         String?   @db.Text
  eventName      String?   @map("event_name")
  idempotencyKey String?   @map("idempotency_key")
  createdAt      DateTime  @default(now())
  wallet         GC_Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@index([walletId])
  @@index([githubId])
  @@index([eventName])
  @@map("gc_transaction")
}

model GCStoreItem {
  id          String        @id @default(uuid())
  name        String
  description String?       @db.Text
  imageUrl    String?       @map("image_url")
  category    String?       @default("Merchandise")
  price       Int           // Price in INR / cash currency
  stock       Int           @default(0)
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?     @map("deleted_at")
  orderItems  GCOrderItem[]
  cartItems   GCCartItem[]

  @@index([isActive, deletedAt])
  @@index([category])
  @@index([name])
  @@map("gc_store_item")
}

model GCCart {
  id        String       @id @default(uuid())
  githubId  String       @unique @map("github_id")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  items     GCCartItem[]
  user      User?        @relation(fields: [githubId], references: [githubId])

  @@map("gc_cart")
}

model GCCartItem {
  id        String      @id @default(uuid())
  cartId    String      @map("cart_id")
  itemId    String      @map("item_id")
  quantity  Int         @default(1)
  size      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  cart      GCCart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  item      GCStoreItem @relation(fields: [itemId], references: [id])

  @@unique([cartId, itemId, size])
  @@index([cartId])
  @@index([itemId])
  @@map("gc_cart_item")
}

model GCOrder {
  id               String        @id @default(uuid())
  githubId         String        @map("github_id")
  totalAmount      Int           @map("total_amount")
  currency         String        @default("INR")
  paymentMethod    PaymentMethod @default(CASH) @map("payment_method")
  paymentStatus    PaymentStatus @default(PENDING) @map("payment_status")
  gatewayOrderId   String?       @map("gateway_order_id")
  gatewayPaymentId String?       @map("gateway_payment_id")
  status           GCOrderStatus @default(PLACED)
  shippingAddress  String?       @map("shipping_address") @db.Text
  contactNumber    String?       @map("contact_number")
  userNote         String?       @map("user_note") @db.Text
  adminNote        String?       @map("admin_note") @db.Text
  idempotencyKey   String?       @unique @map("idempotency_key")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  items            GCOrderItem[]
  user             User?         @relation(fields: [githubId], references: [githubId])

  @@index([githubId, createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@map("gc_order")
}

model GCOrderItem {
  id         String      @id @default(uuid())
  orderId    String      @map("order_id")
  itemId     String      @map("item_id")
  quantity   Int         @default(1)
  unitPrice  Int         @map("unit_price")
  totalPrice Int         @map("total_price")
  size       String?
  createdAt  DateTime    @default(now())
  order      GCOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item       GCStoreItem @relation(fields: [itemId], references: [id])

  @@index([orderId])
  @@index([itemId])
  @@map("gc_order_item")
}

enum LeaderboardEventType {
  PR_MERGED
  ISSUE_COMPLETED
  BONUS
  PENALTY
  MANUAL_ADJUSTMENT
}

enum IssueStatus {
  OPEN
  CLOSED
  ASSIGNED
}

enum PRStatus {
  MERGED
  OPENED
  REJECTED
}

enum GCOrderStatus {
  PLACED
  APPROVED
  FULFILLED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  CASH
  RAZORPAY
  STRIPE
  COD
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model PlatformFeature {
  id               Int      @id @default(1)
  showWinners      Boolean  @default(true)
  showMilestones   Boolean  @default(true)
  showLeaderboard  Boolean  @default(true)
  showRepositories Boolean  @default(true)
  showRPlace       Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("platform_feature")
}
