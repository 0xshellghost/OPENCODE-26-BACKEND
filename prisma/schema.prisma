generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id             String       @id @default(uuid())
  isAdmin        Boolean      @default(false)
  name           String       @db.VarChar(255)
  email          String       @unique
  avatarUrl      String
  college        String
  graduationYear Int
  branch         String
  degree         String
  discordId      String?      @unique
  githubId       String       @unique
  year           String       @db.VarChar(20)
  gender         String       @default("male") @db.VarChar(20)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  Admin          Admin?
  Participant    Participant?

  @@index([githubId])
}

model Admin {
  id     String  @id @default(uuid())
  userId String  @unique
  user   User    @relation(fields: [userId], references: [githubId])
  Event  Event[]
  Repo   Repo[]
}

model Participant {
  id                 String             @id @default(uuid())
  participantId      String             @unique
  User               User               @relation(fields: [participantId], references: [githubId])
  PR                 PR[]
  Issue              Issue[]
  LeaderboardEntries LeaderboardEntry[]
  LeaderboardEvents  LeaderboardEvent[]
}

model Event {
  id                 String             @id @default(cuid())
  creatorId          String
  name               String             @unique
  description        String?
  startDate          DateTime           @default(now())
  endDate            DateTime?
  logoImageURL       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  creator            Admin              @relation(fields: [creatorId], references: [userId])
  Repo               Repo[]
  LeaderBoardEntries LeaderboardEntry[]
  LeaderboardEvents  LeaderboardEvent[]
  coverImagesURL     coverImageURL[]

  @@index([creatorId])
}

model coverImageURL {
  id        Int    @id @default(autoincrement())
  url       String @unique
  eventName String
  event     Event  @relation(fields: [eventName], references: [name])

  @@index([eventName])
}

model LeaderboardEntry {
  id            String      @id @default(uuid())
  participantId String
  eventName     String
  points        Int         @default(0)
  PRmerged      Int         @default(0)
  Participant   Participant @relation(fields: [participantId], references: [participantId])
  event         Event       @relation(fields: [eventName], references: [name])

  @@unique([participantId, eventName])
  @@index([eventName])
}

model LeaderboardEvent {
  id            String               @id @default(uuid())
  participantId String
  eventName     String
  type          LeaderboardEventType
  pointsDelta   Int
  prId          BigInt?
  issueId       String?
  createdAt     DateTime             @default(now())
  participant   Participant          @relation(fields: [participantId], references: [participantId])
  event         Event                @relation(fields: [eventName], references: [name])

  @@index([participantId, createdAt])
  @@index([eventName, createdAt])
  @@index([participantId, eventName])
}

model Repo {
  id            String    @id @default(uuid())
  creatorId     String
  eventName     String
  name          String    @unique
  description   String?
  isFirstYrOnly Boolean   @default(false)
  isGirlsOnly   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  creator       Admin     @relation(fields: [creatorId], references: [userId])
  event         Event     @relation(fields: [eventName], references: [name])
  issues        Issue[]

  @@index([creatorId])
  @@index([eventName])
}

model Issue {
  id            String       @id @default(uuid())
  repoName      String
  issueNumber   Int
  title         String
  status        IssueStatus  @default(OPEN)
  openForAll    Boolean      @default(false)
  currentPoints Int          @default(0)
  assigneeId    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  repo          Repo         @relation(fields: [repoName], references: [name])
  PR            PR[]
  assignee      Participant? @relation(fields: [assigneeId], references: [participantId])

  @@unique([repoName, issueNumber])
  @@index([assigneeId])
}

model PR {
  id          BigInt      @id
  title       String
  prNumber    Int
  points      Int
  status      PRStatus    @default(OPENED)
  submitterId String
  issueId     String
  submitter   Participant @relation(fields: [submitterId], references: [participantId])
  issue       Issue       @relation(fields: [issueId], references: [id])

  @@index([submitterId])
  @@index([issueId])
}

