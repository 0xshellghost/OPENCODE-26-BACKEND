generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id             String       @id @default(uuid())
  isAdmin        Boolean      @default(false)
  name           String       @db.VarChar(255)
  email          String       @unique
  avatarUrl      String
  college        String
  graduationYear Int
  branch         String
  degree         String
  discordId      String?      @unique
  githubId       String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  year           String       @db.VarChar(20)
  gender         String       @default("male") @db.VarChar(20)
  Admin          Admin?
  Participant    Participant?

  @@index([githubId])
}

model Admin {
  id     String  @id @default(uuid())
  userId String  @unique
  user   User    @relation(fields: [userId], references: [githubId])
  Event  Event[]
  Repo   Repo[]
}

model Participant {
  id                   String                @id @default(uuid())
  participantId        String                @unique
  User                 User                  @relation(fields: [participantId], references: [githubId])
  PR                   PR[]
  Issue                Issue[]
  LeaderboardEntries   LeaderboardEntry[]
  LeaderboardSnapshots LeaderboardSnapshot[]
}

model Event {
  id                   String                @id @default(cuid())
  creatorId            String
  name                 String                @unique
  description          String?
  startDate            DateTime              @default(now())
  endDate              DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  logoImageURL         String?
  creator              Admin                 @relation(fields: [creatorId], references: [userId])
  Repo                 Repo[]
  LeaderBoardEntries   LeaderboardEntry[]
  LeaderboardSnapshots LeaderboardSnapshot[]
  coverImagesURL       coverImageURL[]

  @@index([creatorId])
}

model coverImageURL {
  id        Int    @id @default(autoincrement())
  url       String @unique
  eventName String
  event     Event  @relation(fields: [eventName], references: [name])

  @@index([eventName])
}

model LeaderboardEntry {
  id            String      @id @default(uuid())
  participantId String
  eventName     String
  points        Int         @default(0)
  PRmerged      Int         @default(0)
  Participant   Participant @relation(fields: [participantId], references: [participantId])
  event         Event       @relation(fields: [eventName], references: [name])

  @@unique([participantId, eventName])
  @@index([eventName])
}

model Repo {
  id            String    @id @default(uuid())
  creatorId     String
  eventName     String
  name          String    @unique
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  isFirstYrOnly Boolean   @default(false)
  isGirlsOnly   Boolean   @default(false)
  creator       Admin     @relation(fields: [creatorId], references: [userId])
  event         Event     @relation(fields: [eventName], references: [name])
  issues        Issue[]

  @@index([creatorId])
  @@index([eventName])
}

model Issue {
  id            String       @id @default(uuid())
  repoName      String
  assigneeId    String?
  issueNumber   Int
  title         String
  status        IssueStatus  @default(OPEN)
  openForAll    Boolean      @default(false)
  currentPoints Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  repo          Repo         @relation(fields: [repoName], references: [name])
  PR            PR[]
  assignee      Participant? @relation(fields: [assigneeId], references: [participantId])

  @@unique([repoName, issueNumber])
  @@index([assigneeId])
}

model PR {
  id          BigInt      @id
  title       String
  submitterId String
  issueId     String
  prNumber    Int
  points      Int
  status      PRStatus    @default(OPENED)
  submitter   Participant @relation(fields: [submitterId], references: [participantId])
  issue       Issue       @relation(fields: [issueId], references: [id])

  @@index([submitterId])
  @@index([issueId])
}

model LeaderboardSnapshot {
  id            String      @id @default(uuid())
  participantId String
  eventName     String
  date          DateTime
  totalPoints   Int         @default(0)
  PRmerged      Int         @default(0)
  participant   Participant @relation(fields: [participantId], references: [participantId])
  event         Event       @relation(fields: [eventName], references: [name])

  @@unique([participantId, eventName, date])
  @@index([eventName, date])
  @@index([participantId, date])
}

enum IssueStatus {
  OPEN
  CLOSED
  ASSIGNED
}

enum PRStatus {
  MERGED
  OPENED
  REJECTED
}
